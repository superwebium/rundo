rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: change the email below to your actual Google login email.
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == 'REPLACE_WITH_YOUR_GOOGLE_EMAIL';
    }
    match /users/{userId}/progress/{routeId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['done','updatedAt'])
        && request.resource.data.done is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
